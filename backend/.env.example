# =====================================================================
# DIGITAL IDENTITY INTELLIGENCE & OSINT RESOLUTION SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example) - TEAM ACE
# =====================================================================

# SERVER & PORTS
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SECURITY & JWT TOKENS
JWT_SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SYSTEM_API_KEY=YOUR_SYSTEM_API_KEY_HERE

# OSINT SCRAPING API KEYS
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
LINKEDIN_SESSION_COOKIE=your_linkedin_session_cookie_here
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id_here

# DISAMBIGUATION WEIGHTS
WEIGHT_FACIAL=0.40
WEIGHT_BIO=0.35
WEIGHT_HANDLE=0.25
MIN_CONFIDENCE_THRESHOLD=70.0
HIGH_CONFIDENCE_THRESHOLD=85.0

# VECTOR DB & MODELS
CHROMADB_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/sqlite_profile_store.db
DEEPFACE_MODEL_NAME=ArcFace
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
